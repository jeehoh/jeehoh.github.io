---
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';

type Project = {
  title: string;
  description: string;
  href?: string;
  isExternal?: boolean;
};

const projects: Project[] = [
  {
    title: 'Curriculum Vitae Templates',
    description:
      'A small collection of Typst curriculum vitae templates',
    href: 'https://github.com/nghtctrl/cv-templates',
    isExternal: true,
  },
];

const metadata = {
  title: 'Projects',
  useTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <div class='flex flex-col gap-8'>
    {
      projects.map((project) => (
        <section>
          <h2 class='mt-0 mb-1'>
            {project.href ? (
              <Link
                href={project.href}
                isExternal={project.isExternal ?? false}
              >
                {project.title}
              </Link>
            ) : (
              project.title
            )}
          </h2>
          <p>{project.description}</p>
        </section>
      ))
    }
  </div>
</Layout>
